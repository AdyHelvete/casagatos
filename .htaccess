Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On

# Bloquear acceso directo a carpetas internas.
RewriteRule ^lib(/|$) - [F,L]
RewriteRule ^data(/|$) - [F,L]
RewriteRule ^backups(/|$) - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Canonical host: solo cuando el sitio ya vive en el dominio del cliente.
# En preview (tizawebs.com/prospectos/...) estas reglas no deben dispararse.
RewriteCond %{HTTP_HOST} ^www\.lacasadelosgatos\.org$ [NC]
RewriteRule ^ https://lacasadelosgatos.org%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?lacasadelosgatos\.org$ [NC]
RewriteRule ^ https://lacasadelosgatos.org%{REQUEST_URI} [L,R=301]

# El panel y las APIs son apps PHP: no aplicar reglas de URL limpias.
RewriteRule ^control(/|$) - [L]
RewriteRule ^api(/|$) - [L]

# Las redirecciones se arman con %{REQUEST_URI}/%{THE_REQUEST}, nunca con un
# destino relativo: sin RewriteBase, Apache antepone la ruta física del hosting
# (p. ej. /home1/usuario/...). Así funcionan igual en raíz y en /prospectos/<slug>/.
RewriteCond %{THE_REQUEST} \s(\S*/)index\.php[\s?] [NC]
RewriteRule ^index\.php$ %1 [R=301,L]

# Estructura anterior (demo) -> estructura actual. El destino se arma con el
# prefijo capturado de REQUEST_URI para que funcione igual en raíz y en
# subcarpeta de pruebas.
RewriteCond %{REQUEST_URI} ^(.*/)adopciones/([a-z0-9-]+)/?$
RewriteRule ^adopciones/[a-z0-9-]+/?$ %1adopcion/%2/ [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)(adopciones|como-adoptar)/?$
RewriteRule ^(adopciones|como-adoptar)/?$ %1adopcion/ [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)campanas/([a-z0-9-]+)/?$
RewriteRule ^campanas/[a-z0-9-]+/?$ %1tnr/%2/ [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)campanas/?$
RewriteRule ^campanas/?$ %1tnr/ [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)denuncias/?$
RewriteRule ^denuncias/?$ %1asistencia/#denuncias [R=301,NE,L]
RewriteCond %{REQUEST_URI} ^(.*/)(nosotros|galeria)(/.*)?$
RewriteRule ^(nosotros|galeria)(/.*)?$ %1 [R=301,L]

# Fichas de contenido administrable: canonical con barra final.
RewriteCond %{REQUEST_URI} /(adopcion|tnr)/[a-z0-9-]+$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

RewriteRule ^adopcion/([a-z0-9-]+)/$ adopcion/detalle.php?id=$1 [L,QSA]
RewriteRule ^tnr/([a-z0-9-]+)/$ tnr/detalle.php?id=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

# 404 con la plantilla del sitio. ErrorDocument no acepta rutas relativas
# (con "404.php" Apache imprime ese texto), así que se reescribe internamente;
# 404.php ya responde con estado 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
